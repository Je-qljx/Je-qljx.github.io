---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const { title, description, pubDate, tags, githubUrl, demoUrl } = project.data;
const dateText = pubDate.toLocaleDateString('zh-CN', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<BaseLayout title={title} description={description}>
  <div class="container section">
    <article class="project-article">
      <header class="article-head">
        <p class="article-eyebrow" data-reveal>~/projects/{project.id}</p>
        <h1 data-reveal data-reveal-delay="60">{title}</h1>
        <p class="article-meta" data-reveal data-reveal-delay="120">
          <time datetime={pubDate.toISOString()}>{dateText}</time>
        </p>
        <ul
          class="tag-list"
          aria-label="项目标签"
          data-reveal
          data-reveal-delay="160"
        >
          {tags.map((tag) => <li class="tag">{tag}</li>)}
        </ul>
        <div class="article-links" data-reveal data-reveal-delay="200">
          {githubUrl && <a href={githubUrl}>源码</a>}
          {demoUrl && <a href={demoUrl}>在线演示</a>}
        </div>
      </header>

      <div class="prose">
        <Content />
      </div>
    </article>
  </div>
</BaseLayout>

<style>
  .project-article {
    max-width: 60rem;
    margin-inline: auto;
  }

  .article-head {
    margin-bottom: var(--space-12);
    padding-bottom: var(--space-8);
    border-bottom: 1px solid var(--border);
  }

  .article-eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--accent);
  }

  .article-meta {
    margin: 0 0 var(--space-4);
    color: var(--text-muted);
    font-size: var(--text-small);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0 0 var(--space-6);
    padding: 0;
    list-style: none;
  }

  .tag {
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-full);
    background-color: var(--accent-soft);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }

  .article-links {
    display: flex;
    gap: var(--space-4);
  }

  .article-links a {
    font-weight: 600;
  }

  .prose h2 {
    margin-top: var(--space-12);
    font-size: var(--text-h3);
  }

  .prose h3 {
    margin-top: var(--space-8);
  }

  .prose ul {
    margin: 0 0 var(--space-4);
    padding-left: var(--space-6);
  }

  .prose li {
    margin-bottom: var(--space-2);
  }

  .prose p {
    color: var(--text-secondary);
  }
</style>