---
import BaseLayout from '../layouts/BaseLayout.astro';
import { getCollection } from 'astro:content';
import { config } from '../config';
import avatar from '../assets/avatar.svg?url';

const featured = (await getCollection('projects'))
  .filter((project) => project.data.featured)
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
---

<BaseLayout
  title={`${config.name} · 个人主页`}
  description={`${config.name} 的个人主页`}
>
  <!-- 首页：hero / 关于 / 精选项目 / 联系 -->
  <section class="hero">
    <div class="container hero-inner">
      <p class="hero-eyebrow" data-reveal>~/Je</p>
      <h1 class="hero-name" data-reveal data-reveal-delay="60">{config.name}</h1>
      <div
        class="terminal"
        role="img"
        aria-label="终端会话：whoami 与身份标签"
        data-reveal
        data-reveal-delay="120"
      >
        <div class="terminal-bar">
          <span class="terminal-btn terminal-btn-close" aria-hidden="true"></span>
          <span class="terminal-btn terminal-btn-min" aria-hidden="true"></span>
          <span class="terminal-btn terminal-btn-max" aria-hidden="true"></span>
          <span class="terminal-title">~/Je/whoami</span>
        </div>
        <pre class="terminal-body"><code><span class="terminal-prompt">$ </span><span class="terminal-cmd" data-type>whoami</span><span class="terminal-cursor" aria-hidden="true"></span></code>
<code class="terminal-output" data-output hidden>{config.name}</code>
<code><span class="terminal-prompt">$ </span><span class="terminal-cmd" data-type>cat tagline.txt</span><span class="terminal-cursor" aria-hidden="true"></span></code>
<code class="terminal-output" data-output hidden>{config.tagline}</code></pre>
      </div>
    </div>
  </section>

  <section class="section" id="about">
    <div class="container">
      <p class="section-eyebrow" data-reveal>~/Je/about</p>
      <h2 data-reveal data-reveal-delay="60">关于</h2>
      <div class="about-grid">
        <img
          class="about-avatar"
          src={avatar}
          alt={`${config.name} 的头像`}
          width="160"
          height="160"
          data-reveal
        />
        <div
          class="terminal terminal-wide"
          role="img"
          aria-label="终端输出：个人简介"
          data-reveal
          data-reveal-delay="80"
          data-typing-gate
        >
          <div class="terminal-bar">
            <span class="terminal-btn terminal-btn-close" aria-hidden="true"></span>
            <span class="terminal-btn terminal-btn-min" aria-hidden="true"></span>
            <span class="terminal-btn terminal-btn-max" aria-hidden="true"></span>
            <span class="terminal-title">~/Je/about</span>
          </div>
          <pre class="terminal-body"><code><span class="terminal-prompt">$ </span><span class="terminal-cmd" data-type>cat about.txt</span><span class="terminal-cursor" aria-hidden="true"></span></code>
<code class="terminal-output" data-output hidden>{config.bio}</code></pre>
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="projects">
    <div class="container">
      <p class="section-eyebrow" data-reveal>~/Je/projects</p>
      <h2 data-reveal data-reveal-delay="60">精选项目</h2>
      <ul class="featured-grid">
        {
          featured.map((project, i) => (
            <li class="featured-card" data-tilt data-reveal data-reveal-delay={i * 100}>
              <h3 class="featured-title">
                <a href={`/projects/${project.id}/`}>{project.data.title}</a>
              </h3>
              <p class="featured-desc">{project.data.description}</p>
              <ul class="tag-list" aria-label="项目标签">
                {project.data.tags.map((tag) => <li class="tag">{tag}</li>)}
              </ul>
            </li>
          ))
        }
      </ul>
      <a class="all-link" href="/projects/" data-reveal data-reveal-delay="120">
        查看全部项目
      </a>
    </div>
  </section>

  <section class="section" id="contact">
    <div class="container">
      <p class="section-eyebrow" data-reveal>~/Je/contact</p>
      <h2 data-reveal data-reveal-delay="60">联系</h2>
      <p class="contact-intro" data-reveal data-reveal-delay="80">
        欢迎通过邮件或 GitHub 联系我。
      </p>
      <div class="contact-links">
        <a class="contact-link" href={`mailto:${config.socials.email}`} data-reveal>
          邮件
        </a>
        <a class="contact-link" href={config.socials.github} data-reveal data-reveal-delay="80">
          GitHub
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<script is:inline>
  (function () {
    var cmds = document.querySelectorAll('[data-type]');
    if (!cmds.length) return;
    var reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // One typing job per command line, in document order. Each command's
    // output is the sibling <code data-output> right after its own line.
    var jobs = [];
    for (var i = 0; i < cmds.length; i += 1) {
      var cmd = cmds[i];
      var line = cmd.closest('code');
      var out = line ? line.nextElementSibling : null;
      if (!out || !out.hasAttribute('data-output')) continue;
      // The final command of each window keeps its blinking cursor.
      var box = cmd.closest('.terminal');
      var windowCmds = box ? box.querySelectorAll('[data-type]') : [cmd];
      jobs.push({
        cmd: cmd,
        out: out,
        cursor: cmd.nextElementSibling,
        text: '',
        outText: '',
        keepCursor: windowCmds[windowCmds.length - 1] === cmd,
      });
    }
    if (!jobs.length) return;

    if (reduced) {
      for (var r = 0; r < jobs.length; r += 1) {
        jobs[r].out.hidden = false;
      }
      return;
    }

    // Capture texts and clear content up front: waiting prompts show an idle
    // cursor, and outputs reveal empty so nothing flashes before printing.
    for (var c = 0; c < jobs.length; c += 1) {
      jobs[c].text = jobs[c].cmd.textContent;
      jobs[c].cmd.textContent = '';
      jobs[c].outText = jobs[c].out.textContent;
      jobs[c].out.textContent = '';
    }

    var TYPE_INTERVAL = 90;
    var NEXT_DELAY = 400;

    function typeOutput(job, done) {
      if (!job.outText) {
        done();
        return;
      }
      job.out.hidden = false;
      // The cursor trails the growing output text, like a live feed.
      var j = 0;
      var timer = window.setInterval(function () {
        j += 1;
        job.out.textContent = job.outText.slice(0, j);
        if (job.cursor) {
          job.out.appendChild(job.cursor);
        }
        if (j >= job.outText.length) {
          window.clearInterval(timer);
          // Retire the cursor unless it belongs to the window's final command.
          if (!job.keepCursor && job.cursor) {
            job.cursor.classList.add('is-done');
          }
          done();
        }
      }, TYPE_INTERVAL);
    }

    function typeOne(job, done) {
      var i = 0;
      var timer = window.setInterval(function () {
        i += 1;
        job.cmd.textContent = job.text.slice(0, i);
        if (i >= job.text.length) {
          window.clearInterval(timer);
          typeOutput(job, done);
        }
      }, TYPE_INTERVAL);
    }

    // Ungated terminals play on load, in document order. Gated ones start
    // when their section trips the same viewport band that flips the header
    // path (identical rootMargin on the same section), so the text and the
    // address swap together.
    var immediate = [];
    var gated = [];
    for (var j = 0; j < jobs.length; j += 1) {
      var term = jobs[j].cmd.closest('.terminal');
      var section = term ? term.closest('section[id]') : null;
      if (term && term.hasAttribute('data-typing-gate') && section) {
        gated.push({ job: jobs[j], section: section });
      } else {
        immediate.push(jobs[j]);
      }
    }

    function runChain(list, k) {
      if (k >= list.length) return;
      typeOne(list[k], function () {
        window.setTimeout(function () {
          runChain(list, k + 1);
        }, NEXT_DELAY);
      });
    }
    runChain(immediate, 0);

    function watchGated(k) {
      if (k >= gated.length) return;
      var item = gated[k];
      var io = new IntersectionObserver(
        function (entries) {
          for (var e = 0; e < entries.length; e += 1) {
            if (!entries[e].isIntersecting) continue;
            io.disconnect();
            typeOne(item.job, function () {
              watchGated(k + 1);
            });
            break;
          }
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );
      io.observe(item.section);
    }
    watchGated(0);
  })();
</script>

<style>
  /* hero */
  .hero {
    padding-block: var(--space-16) var(--space-24);
  }

  @media (min-width: 48rem) {
    .hero {
      padding-block: var(--space-24);
    }
  }

  .hero-eyebrow {
    margin: 0 0 var(--space-4);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--accent);
  }

  .hero-name {
    margin: 0 0 var(--space-8);
    font-size: var(--text-display);
  }

  /* terminal signature */
  .terminal {
    max-width: 34rem;
    overflow: hidden;
    border: 1px solid var(--terminal-border);
    border-radius: var(--radius-terminal);
    background-color: var(--terminal-bg);
    box-shadow: var(--shadow-lg);
    transition:
      border-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .terminal-wide {
    max-width: 40rem;
  }

  .terminal:hover {
    box-shadow:
      var(--shadow-lg),
      0 0 36px rgb(var(--shadow-color) / 0.35),
      0 0 10px rgb(var(--shadow-color) / 0.28);
  }

  .terminal-bar {
    display: flex;
    align-items: center;
    gap: var(--space-2);
    padding: var(--space-3) var(--space-4);
    border-bottom: 1px solid var(--terminal-border);
  }

  .terminal-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 0.75rem;
    height: 0.75rem;
    border-radius: var(--radius-full);
    font-family: var(--font-mono);
    font-size: 0.625rem;
    font-weight: 700;
    -webkit-text-stroke: 0.4px currentColor;
    line-height: 1;
    color: rgba(0, 0, 0, 0.65);
  }

  .terminal-btn::before {
    content: '';
    /* Small-size rasterization snaps glyph ink ~1px above the circle
       center; measured via pixel centroid at native resolution. */
    transform: translateY(1px);
    opacity: 0;
    transition: opacity var(--transition-fast);
  }

  .terminal-btn-close {
    background-color: #ff5f57;
  }

  .terminal-btn-close::before {
    content: '×';
  }

  .terminal-btn-min {
    background-color: #febc2e;
  }

  .terminal-btn-min::before {
    content: '-';
  }

  .terminal-btn-max {
    background-color: #28c840;
  }

  .terminal-btn-max::before {
    content: '+';
  }

  .terminal:hover .terminal-btn::before {
    opacity: 1;
  }

  .terminal-title {
    margin-left: auto;
    font-family: var(--font-mono);
    font-size: var(--text-caption);
    color: var(--terminal-text);
    opacity: 0.7;
  }

  .terminal-body {
    margin: 0;
    padding: var(--space-4) var(--space-6);
    overflow-x: auto;
    border: 0;
    background-color: transparent;
    line-height: var(--leading-snug);
  }

  .terminal-prompt {
    color: var(--terminal-accent);
    font-weight: 600;
  }

  .terminal-cmd {
    color: var(--terminal-text);
  }

  .terminal-cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.1em;
    margin-left: 2px;
    vertical-align: text-bottom;
    background-color: var(--terminal-accent);
    animation: cursor-blink 1.1s steps(2, start) infinite;
  }

  .terminal-cursor.is-done {
    display: none;
  }

  @keyframes cursor-blink {
    to {
      visibility: hidden;
    }
  }

  .terminal-output {
    color: var(--terminal-text);
    white-space: pre-wrap;
    overflow-wrap: break-word;
  }

  .terminal-output[hidden] {
    display: none;
  }

  /* Hero terminal keeps its final size while typing: reserve hidden
     output lines instead of collapsing them, so the window never grows
     mid-animation and content below stays put. */
  .terminal:not(.terminal-wide) .terminal-output[hidden] {
    display: inline;
    visibility: hidden;
  }

  /* The animation script empties outputs up front to avoid flashing;
     an empty inline box generates no line box, so anchor one with a
     zero-width space and the reserved line survives until typing starts. */
  .terminal:not(.terminal-wide) .terminal-output::before {
    content: '\200B';
  }

  /* sections */
  .section-eyebrow {
    margin: 0 0 var(--space-2);
    font-family: var(--font-mono);
    font-size: var(--text-mono);
    color: var(--accent);
  }

  /* about */
  .about-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-8);
    align-items: start;
  }

  @media (min-width: 48rem) {
    .about-grid {
      grid-template-columns: 10rem 1fr;
    }
  }

  .about-avatar {
    width: 10rem;
    height: 10rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    box-shadow: var(--shadow-sm);
  }

  /* featured projects */
  .featured-grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: var(--space-6);
    margin: 0 0 var(--space-8);
    padding: 0;
    list-style: none;
  }

  @media (min-width: 48rem) {
    .featured-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  .featured-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: var(--space-3);
    padding: var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-lg);
    background-color: var(--surface);
    box-shadow: var(--shadow-sm);
    cursor: pointer;
    transform: perspective(900px) translateY(var(--lift, 0px))
      rotateX(var(--ry, 0deg)) rotateY(var(--rx, 0deg))
      scale(var(--press, 1));
    transition: transform var(--transition-base),
      border-color var(--transition-base), box-shadow var(--transition-base);
  }

  .featured-card:hover {
    --lift: -3px;
    border-color: var(--accent);
    box-shadow: var(--shadow-md);
  }

  .featured-card:active {
    --press: 0.98;
  }

  /* Cursor spotlight — script feeds --mx/--my while the pointer moves */
  .featured-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    pointer-events: none;
    opacity: 0;
    background: radial-gradient(
      9rem circle at var(--mx, 50%) var(--my, 50%),
      color-mix(in srgb, var(--accent) 12%, transparent),
      transparent 65%
    );
    transition: opacity var(--transition-fast);
  }

  html.motion-ok .featured-card.is-tilting::after {
    opacity: 1;
  }

  .featured-title {
    margin: 0;
    font-size: var(--text-h3);
  }

  .featured-title a {
    color: var(--text);
    text-decoration: none;
  }

  .featured-title a:hover {
    color: var(--accent);
  }

  .featured-desc {
    margin: 0;
    color: var(--text-secondary);
    font-size: var(--text-small);
  }

  .tag-list {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tag {
    padding: 0.125rem 0.625rem;
    border-radius: var(--radius-full);
    background-color: var(--accent-soft);
    color: var(--accent-strong);
    font-family: var(--font-mono);
    font-size: var(--text-caption);
  }

  .all-link {
    font-weight: 600;
  }

  /* contact */
  .contact-intro {
    max-width: 36rem;
    margin: 0 0 var(--space-8);
    color: var(--text-secondary);
  }

  .contact-links {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-4);
  }

  .contact-link {
    display: inline-flex;
    align-items: center;
    padding: var(--space-3) var(--space-6);
    border: 1px solid var(--border);
    border-radius: var(--radius-md);
    background-color: var(--surface);
    color: var(--text);
    font-weight: 600;
    text-decoration: none;
    transition: border-color var(--transition-fast),
      color var(--transition-fast), transform var(--transition-fast);
  }

  .contact-link:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  .contact-link:active {
    transform: scale(0.95);
  }
</style>