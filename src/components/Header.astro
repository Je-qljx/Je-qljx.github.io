---
import { config } from '../config';

const nav = [
  { href: '/', label: '首页' },
  { href: '/projects', label: '项目' },
  { href: '/blog', label: '博客' },
  { href: '/matrix/', label: '矩阵' },
  { href: '/contact/', label: '联系' },
];
---

<header class="site-header">
  <div class="container header-inner">
    <nav class="site-path" aria-label="当前路径">
      <a class="path-home" href="/" aria-label={`${config.name} 首页`}>
        <span class="path-mark" aria-hidden="true">~/</span>
        <span>{config.name}</span>
      </a>
      <ol class="path-rest" data-path-rest hidden></ol>
    </nav>

    <nav class="site-nav" aria-label="主导航">
      <ul class="nav-list">
        {
          nav.map((item) => (
            <li>
              <a href={item.href}>{item.label}</a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      class="theme-toggle"
      type="button"
      aria-label="切换主题"
      aria-pressed="false"
      data-theme-toggle
    >
      <span class="theme-toggle-icon" aria-hidden="true"></span>
    </button>
  </div>
</header>

<script is:inline>
  (function () {
    var btn = document.querySelector('[data-theme-toggle]');
    if (!btn) return;

    function current() {
      return document.documentElement.getAttribute('data-theme') === 'dark'
        ? 'dark'
        : 'light';
    }

    function sync() {
      var dark = current() === 'dark';
      btn.setAttribute('aria-pressed', String(dark));
      btn.setAttribute('aria-label', dark ? '切换到浅色主题' : '切换到深色主题');
    }

    btn.addEventListener('click', function () {
      var next = current() === 'dark' ? 'light' : 'dark';
      document.documentElement.setAttribute('data-theme', next);
      try {
        localStorage.setItem('theme', next);
      } catch (e) {
        /* ignore */
      }
      sync();
      // One-shot pop feedback (CSS-gated to motion-enabled sessions).
      btn.classList.remove('theme-pop');
      void btn.offsetWidth;
      btn.classList.add('theme-pop');
    });

    sync();
  })();
</script>

<script is:inline>
  (function () {
    function init() {
      var rest = document.querySelector('[data-path-rest]');
      if (!rest) return;

      // Path segments that are real pages link there; 'about' only exists as a
      // homepage section, so it anchors to the section instead.
      var PAGE_HREFS = { projects: '/projects/', blog: '/blog/', matrix: '/matrix/', contact: '/contact/' };
      var curPath = location.pathname.replace(/\/+$/, '') || '/';
      var current;

      function render(suffix, animate, tailIsCurrent) {
        if (suffix === current) return;
        current = suffix;

        while (rest.firstChild) rest.removeChild(rest.firstChild);
        var parts = suffix ? suffix.split('/') : [];
        for (var i = 0; i < parts.length; i += 1) {
          var part = parts[i];
          var li = document.createElement('li');
          var isTail = i === parts.length - 1;
          var mapped = PAGE_HREFS[part];
          var node;
          // The trailing segment of a real path is the page you are on, so it
          // renders as plain text; homepage section crumbs always link.
          if ((tailIsCurrent && isTail) || (mapped && mapped.replace(/\/+$/, '') === curPath)) {
            node = document.createElement('span');
            node.setAttribute('aria-current', 'page');
          } else {
            node = document.createElement('a');
            node.href = mapped || '/#' + part;
          }
          node.className = 'path-seg';
          node.textContent = part;
          li.appendChild(node);
          rest.appendChild(li);
        }
        rest.hidden = parts.length === 0;

        if (!animate || !document.documentElement.classList.contains('motion-ok')) {
          return;
        }
        rest.classList.remove('name-pop');
        void rest.offsetWidth;
        rest.classList.add('name-pop');
      }

      var base = location.pathname.replace(/^\/+|\/+$/g, '');
      render(base, false, true);

      var sections = document.querySelectorAll('main section[id]');
      if (!sections.length) return;

      var visible = [];
      var lastActive = null;
      var io = new IntersectionObserver(
        function (entries) {
          for (var i = 0; i < entries.length; i += 1) {
            var entry = entries[i];
            var idx = visible.indexOf(entry.target);
            if (entry.isIntersecting && idx === -1) visible.push(entry.target);
            if (!entry.isIntersecting && idx !== -1) visible.splice(idx, 1);
          }
          var active = null;
          for (var s = 0; s < sections.length; s += 1) {
            if (visible.indexOf(sections[s]) !== -1) active = sections[s];
          }
          if (active) lastActive = active.id;
          render(active ? lastActive : window.scrollY === 0 ? base : lastActive, true);
        },
        { rootMargin: '-45% 0px -45% 0px', threshold: 0 }
      );
      for (var t = 0; t < sections.length; t += 1) io.observe(sections[t]);

      // IO only fires on intersection changes, so a smooth scroll landing
      // exactly at the top would never re-evaluate. Cheap guarded check.
      window.addEventListener(
        'scroll',
        function () {
          if (!visible.length && window.scrollY === 0) {
            render(base, true);
          }
        },
        { passive: true }
      );
    }

    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', init);
    } else {
      init();
    }
  })();
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: var(--z-header);
    background-color: color-mix(in srgb, var(--bg) 82%, transparent);
    backdrop-filter: blur(8px);
    border-bottom: 1px solid var(--border);
    transition: background-color var(--transition-base),
      box-shadow var(--transition-base);
  }

  .site-header.is-scrolled {
    background-color: color-mix(in srgb, var(--bg) 92%, transparent);
    box-shadow: var(--shadow-sm);
  }

  .header-inner {
    display: flex;
    align-items: center;
    gap: var(--space-6);
    min-height: 3.5rem;
  }

  .site-path {
    display: inline-flex;
    align-items: baseline;
    min-width: 0;
    overflow: hidden;
    white-space: nowrap;
  }

  .path-home {
    display: inline-flex;
    align-items: baseline;
    gap: var(--space-1);
    flex-shrink: 0;
    font-family: var(--font-mono);
    font-size: var(--text-body);
    color: var(--accent);
    text-decoration: none;
  }

  .path-mark {
    font-size: var(--text-mono);
  }

  .path-rest {
    display: inline-flex;
    align-items: baseline;
    min-width: 0;
    margin: 0;
    padding: 0;
    list-style: none;
    font-family: var(--font-mono);
    font-size: var(--text-body);
  }

  .path-rest[hidden] {
    display: none;
  }

  .site-nav {
    margin-left: auto;
  }

  .nav-list {
    display: flex;
    gap: var(--space-6);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .nav-list a {
    color: var(--text-secondary);
    text-decoration: none;
    font-weight: 500;
    background-image: linear-gradient(var(--accent), var(--accent));
    background-repeat: no-repeat;
    background-size: 0% 2px;
    background-position: 0 calc(100% - 2px);
    transition: color var(--transition-fast),
      background-size var(--transition-base);
  }

  .nav-list a:hover {
    color: var(--accent);
    background-size: 100% 2px;
  }

  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 2.25rem;
    height: 2.25rem;
    padding: 0;
    border: 1px solid var(--border);
    border-radius: var(--radius-full);
    background-color: var(--surface);
    color: var(--text);
    cursor: pointer;
    transition: border-color var(--transition-fast),
      background-color var(--transition-fast),
      transform var(--transition-fast);
  }

  .theme-toggle:hover {
    border-color: var(--border-strong);
  }

  .theme-toggle:active {
    transform: scale(0.88);
  }

  /* One-shot pop on theme switch (gated to motion-enabled sessions) */
  html.motion-ok .theme-toggle.theme-pop {
    animation: theme-pop 400ms var(--ease-out);
  }

  @keyframes theme-pop {
    0% {
      transform: scale(1);
    }
    40% {
      transform: scale(0.82);
    }
    100% {
      transform: scale(1);
    }
  }

  @keyframes name-pop {
    0% {
      opacity: 0.55;
      transform: translateY(0.15em);
    }
    100% {
      opacity: 1;
      transform: translateY(0);
    }
  }

  html.motion-ok .path-rest.name-pop {
    animation: name-pop 280ms var(--ease-out);
  }

  .theme-toggle-icon {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: var(--radius-full);
    background-color: var(--accent);
    box-shadow: inset 0 0 0 2px var(--surface);
  }

  @media (max-width: 40rem) {
    .nav-list {
      gap: var(--space-4);
    }
  }
</style>

<!-- Crumb <li>/<a> nodes are built by the script at runtime, so they never
     carry Astro's scoped attribute — these rules must stay unscoped. -->
<style is:global>
  .path-rest li {
    display: inline-flex;
    align-items: baseline;
    min-width: 0;
  }

  .path-rest::before {
    content: '/';
    margin: 0 var(--space-1);
    color: var(--accent);
  }

  .path-rest li + li::before {
    content: '/';
    margin: 0 var(--space-1);
    color: var(--accent);
  }

  .path-seg {
    color: var(--accent);
    text-decoration: none;
    transition: color var(--transition-fast);
  }

  a.path-seg:hover {
    color: var(--accent-strong);
  }
</style>
